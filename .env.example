# Telegram
TELEGRAM_BOT_TOKEN=<from @BotFather>
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=<your_bot_username>
NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=<your_app_short_name>
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# How long received Telegram init data stays valid, in seconds (optional).
# Defaults to 86400 (24h), matching Telegram's own reference implementation.
# Do not lower this aggressively: on Telegram Web, init data is carried in the
# URL fragment and never refreshes, so a short window breaks every request
# once the page has been open longer than that. Set 0 to disable entirely.
INIT_DATA_MAX_AGE_SECONDS=86400

# Supabase
NEXT_PUBLIC_SUPABASE_URL=<project_url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key>
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Upstash (rate limiting)
UPSTASH_REDIS_REST_URL=<url>
UPSTASH_REDIS_REST_TOKEN=<token>

# Security
SUPABASE_JWT_SECRET=<from Supabase dashboard > Project Settings > API > JWT Secret>
CRON_SECRET=<run: openssl rand -hex 32>
TELEGRAM_WEBHOOK_SECRET=<generate a random secret>

# Dev mock (optional, for local development outside Telegram)
NEXT_PUBLIC_MOCK_INIT_DATA=
